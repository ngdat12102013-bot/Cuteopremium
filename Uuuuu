    <script>
        // Hệ thống quản lý và kiểm tra Key
        const KeySystem = {
            generateKey(type) {
                const prefix = "UCHIHA";
                const randomStr = Math.random().toString(36).substring(2, 8).toUpperCase();
                let expireTime = Date.now();
                let typeName = "";

                switch(type) {
                    case 'day':
                        expireTime += 24 * 60 * 60 * 1000;
                        typeName = "NGAY";
                        break;
                    case 'week':
                        expireTime += 7 * 24 * 60 * 60 * 1000;
                        typeName = "TUAN";
                        break;
                    case 'month':
                        expireTime += 30 * 24 * 60 * 60 * 1000;
                        typeName = "THANG";
                        break;
                    case 'vv':
                        expireTime = null; // Vĩnh viễn
                        typeName = "VV";
                        break;
                }

                const fullKey = `${prefix}-${typeName}-${randomStr}`;
                localStorage.setItem(fullKey, JSON.stringify({ type: typeName, expires: expireTime }));
                return fullKey;
            },

            verify(inputKey) {
                if (!inputKey) return { success: false, msg: "Vui lòng nhập mã bản quyền!" };
                
                // Key mặc định để test nhanh hoặc Master Key
                if (inputKey === "UCHIHA-VIP-2026" || inputKey === "ADMIN") {
                    return { success: true, msg: "Xác thực thành công!" };
                }

                const keyData = localStorage.getItem(inputKey);
                if (!keyData) {
                    return { success: false, msg: "Key không tồn tại hoặc không hợp lệ!" };
                }

                const parsed = JSON.parse(keyData);
                if (parsed.expires && Date.now() > parsed.expires) {
                    localStorage.removeItem(inputKey);
                    return { success: false, msg: "Key này đã hết hạn sử dụng!" };
                }

                return { success: true, msg: `Kích hoạt thành công (${parsed.type})!` };
            }
        };

        // Hàm kiểm tra khi người dùng bấm nút xác thực
        function verifyAndEnterKey() {
            const keyInput = document.getElementById('license-key-input').value.trim();
            const errorMsg = document.getElementById('auth-error-msg');
            
            const result = KeySystem.verify(keyInput);
            if (!result.success) {
                errorMsg.textContent = result.msg;
                return;
            }

            // Ẩn màn hình nhập key, hiện app chính
            document.getElementById('auth-screen').style.display = 'none';
            document.getElementById('main-app-wrapper').style.display = 'flex';
            logToConsole("[System] Đã đăng nhập hệ thống thành công bằng Key.");
        }

        // Đăng xuất / Đổi key
        function logoutApp() {
            document.getElementById('main-app-wrapper').style.display = 'none';
            document.getElementById('auth-screen').style.display = 'flex';
            document.getElementById('license-key-input').value = '';
            document.getElementById('auth-error-msg').textContent = '';
        }

        window.onload = function() {
            const randomId = 'UCHIHA-' + Math.random().toString(36).substring(2, 9).toUpperCase();
            document.getElementById('display-device-id').textContent = randomId;
            initCharts();
        };

        function switchTab(tabId, btnElement) {
            document.querySelectorAll('.view-section').forEach(sec => sec.classList.remove('active'));
            const target = document.getElementById('view-' + tabId);
            if (target) target.classList.add('active');

            document.querySelectorAll('.nav-item').forEach(nav => nav.classList.remove('active'));
            btnElement.classList.add('active');
        }

        let logCount = 2;
        let errorCount = 0;

        function logToConsole(text, isError = false) {
            const consoleBox = document.getElementById('live-console');
            if(!consoleBox) return;
            const timeStr = new Date().toTimeString().split(' ')[0] + "." + Math.floor(Math.random() * 900 + 100);
            const line = document.createElement('div');
            line.className = isError ? 'console-line error' : 'console-line';
            line.textContent = `[${timeStr}] ${text}`;
            consoleBox.appendChild(line);
            consoleBox.scrollTop = consoleBox.scrollHeight;

            if (isError) errorCount++; else logCount++;
            document.getElementById('log-count').textContent = logCount;
            document.getElementById('error-count').textContent = errorCount;
        }

        function clearConsole() {
            document.getElementById('live-console').innerHTML = '';
            logCount = 0; errorCount = 0;
            document.getElementById('log-count').textContent = logCount;
            document.getElementById('error-count').textContent = errorCount;
            logToConsole("Console đã được làm sạch.");
        }

        function sendTerminalCommand() {
            const input = document.getElementById('terminal-input');
            const val = input.value.trim();
            if (!val) return;
            logToConsole(`> ${val}`);
            try {
                if (val === 'help()') {
                    logToConsole("Available commands: clearConsole(), KeySystem.generateKey('day'|'week'|'month'|'vv')");
                } else {
                    const result = eval(val);
                    logToConsole(result !== undefined ? String(result) : "Executed successfully.");
                }
            } catch (err) {
                logToConsole(err.message, true);
            }
            input.value = '';
        }

        function handleTerminalKey(e) {
            if (e.key === 'Enter') sendTerminalCommand();
        }

        let is120FPSUnlocked = false;
        function toggleUnlockFPS() {
            is120FPSUnlocked = !is120FPSUnlocked;
            const btn = document.getElementById('btn-unlock-fps');
            btn.textContent = `UnLock 120 FPS : ${is120FPSUnlocked ? 'ON' : 'OFF'}`;
            logToConsole(`[Module] Unlock 120 FPS set to ${is120FPSUnlocked ? 'ON' : 'OFF'}`);
        }

        function triggerAction(actionName) {
            logToConsole(`[Action] Đang thực thi: ${actionName}...`);
            setTimeout(() => {
                logToConsole(`[Action] ${actionName} hoàn tất thành công!`);
            }, 400);
        }

        function initCharts() {
            const cpuCanvas = document.getElementById('cpuWaveCanvas');
            const ramCanvas = document.getElementById('ramWaveCanvas');
            if(!cpuCanvas || !ramCanvas) return;
            
            setupCanvasSize(cpuCanvas);
            setupCanvasSize(ramCanvas);

            setInterval(() => {
                drawWave(cpuCanvas, '#ff3366', 2, 8);
                drawWave(ramCanvas, '#00ffcc', 150, 40);
                
                document.getElementById('live-fps').textContent = Math.floor(Math.random() * 8 + 52);
                document.getElementById('live-cpu').textContent = Math.floor(Math.random() * 5 + 1) + '%';
                document.getElementById('live-ram').textContent = (180 + Math.floor(Math.random() * 15)) + ' MB';
            }, 800);
        }

        function setupCanvasSize(canvas) {
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
        }

        function drawWave(canvas, color, baseVal, variance) {
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            ctx.beginPath();
            ctx.strokeStyle = color;
            ctx.lineWidth = 2;

            const points = 20;
            const step = canvas.width / points;

            for (let i = 0; i <= points; i++) {
                const x = i * step;
                const y = canvas.height - (baseVal + Math.sin(i + Date.now() * 0.003) * variance + Math.random() * 5);
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            }
            ctx.stroke();
        }
    </script></body></html>
