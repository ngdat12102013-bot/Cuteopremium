<!DOCTYPE html><html lang="vi"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Unimate Secret V3 - Ultimate Mobile Booster</title>
    <style>
        :root {
            --bg-color: #0b090a;
            --card-bg: #161113;
            --card-border: #2a1f22;
            --accent-pink: #ff3366;
            --accent-glow: rgba(255, 51, 102, 0.35);
            --text-main: #f5f0f2;
            --text-muted: #9e8a90;
            --carbon-gradient: linear-gradient(135deg, #1c1518 0%, #0d0a0b 100%);
            --titan-metal: linear-gradient(135deg, #2c2528 0%, #120e10 100%);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-color);
            background-image: var(--carbon-gradient);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #auth-screen {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: var(--bg-color);
            background-image: var(--carbon-gradient);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 24px;
        }

        .auth-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 24px;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.6);
            text-align: center;
        }

        .auth-logo {
            width: 64px; height: 64px;
            background: linear-gradient(135deg, #ff3366, #7a0022);
            border-radius: 16px;
            margin: 0 auto 16px auto;
            display: flex; align-items: center; justify-content: center;
            font-size: 26px; font-weight: 800; color: #fff;
            box-shadow: 0 0 20px var(--accent-glow);
        }

        .auth-card h2 { font-size: 18px; font-weight: 800; color: #fff; margin-bottom: 6px; }
        .auth-card p { font-size: 12px; color: var(--text-muted); margin-bottom: 20px; }
        
        .auth-input-group { display: flex; flex-direction: column; gap: 12px; }
        .auth-input-group input {
            background: #070506; border: 1px solid var(--card-border);
            border-radius: 12px; padding: 14px 16px; color: #fff;
            font-size: 13px; outline: none; text-align: center; letter-spacing: 1px;
        }
        .auth-input-group input:focus { border-color: var(--accent-pink); box-shadow: 0 0 10px var(--accent-glow); }

        .auth-btn, .booster-btn-main {
            background: linear-gradient(135deg, #ff1a4a 0%, #b3002d 100%);
            color: white; border: none; padding: 14px;
            border-radius: 12px; font-weight: 700; font-size: 13px;
            letter-spacing: 0.5px; box-shadow: 0 4px 15px var(--accent-glow);
            cursor: pointer; transition: transform 0.1s;
        }
        .auth-btn:active, .booster-btn-main:active { transform: scale(0.96); }

        .auth-error { color: #ff3366; font-size: 11px; margin-top: 10px; min-height: 16px; font-weight: 600; }
        .device-info { margin-top: 15px; font-size: 11px; color: var(--text-muted); }

        #main-app-wrapper {
            display: none;
            flex: 1; flex-direction: column; height: 100vh; overflow: hidden;
        }

        .top-status-bar {
            display: flex; justify-content: space-between; align-items: center;
            padding: 12px 20px; font-size: 13px; color: var(--text-muted);
            border-bottom: 1px solid rgba(255,255,255,0.03);
        }

        .app-container {
            flex: 1; overflow-y: auto; padding: 16px; padding-bottom: 90px;
        }

        .view-section { display: none; animation: fadeIn 0.25s ease-in-out; }
        .view-section.active { display: block; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .section-header {
            background: var(--titan-metal); border: 1px solid var(--card-border);
            border-radius: 16px; padding: 18px; margin-bottom: 16px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }
        .section-header .subtitle {
            font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px;
            color: var(--accent-pink); font-weight: 700; margin-bottom: 4px;
        }
        .section-header h2 { font-size: 20px; font-weight: 800; letter-spacing: 0.5px; color: #fff; }
        .section-header p { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

        .live-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 16px;
            margin-bottom: 16px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.4);
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 12px;
        }

        .metric-box {
            background: #070506;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .metric-label { font-size: 12px; color: var(--text-muted); font-weight: 600; }
        .metric-value { font-size: 14px; color: #fff; font-weight: 800; }

        .controls-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 12px;
        }

        .control-action-btn {
            background: #070506;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 14px 10px;
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
        }
        .control-action-btn:active {
            border-color: var(--accent-pink);
            background: rgba(255,51,102,0.1);
            transform: scale(0.96);
        }

        .canvas-container {
            background: #070506;
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 10px;
            margin-top: 10px;
            height: 120px;
            position: relative;
            overflow: hidden;
        }

        canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        .console-header-row {
            display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;
        }
        .console-badges { display: flex; gap: 8px; }
        .badge-pill {
            background: #070506; border: 1px solid var(--card-border);
            border-radius: 10px; padding: 4px 10px; font-size: 11px; color: var(--text-muted);
        }
        .badge-pill span { color: var(--accent-pink); font-weight: 700; }

        .live-console-box {
            background: #070506; border: 1px solid var(--card-border);
            border-radius: 12px; padding: 12px; font-family: 'Courier New', Courier, monospace;
            font-size: 11px; color: #00ffcc; height: 150px; overflow-y: auto;
            margin-bottom: 10px; line-height: 1.4;
        }
        .console-line { margin-bottom: 3px; word-break: break-all; }
        .console-line.error { color: #ff3366; }

        .js-input-group { display: flex; gap: 8px; }
        .js-input-group input {
